{
  "name": "ctpamap-electron",
  "version": "1.2.0",
  "description": "CTPA Lung Subtraction Perfusion Mapper - GUI",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2",
    "nifti-reader-js": "^0.6.8"
  },
  "devDependencies": {
    "electron-vite": "^2.3.0",
    "vite": "^5.4.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  },
  "build": {
    "appId": "com.ctpamap.app",
    "productName": "CTPAMAP",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist-electron/main/**",
      "dist-electron/preload/**",
      "dist-electron/renderer/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CTPAMAP-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Science",
      "artifactName": "CTPAMAP-${version}-x86_64.${ext}"
    }
  }
}
